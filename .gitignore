# Downloaded material is untrusted and often large; provenance (URL, sha256,
# date) is recorded in raw/MANIFEST.md, which is tracked.
raw/*
!raw/.gitkeep
!raw/MANIFEST.md
.venv/
__pycache__/
*.pyc
.pytest_cache/
# export/ is regenerated by scripts/export.py
export/*
!export/.gitkeep
# the chat/text layer and its README are committed (training inputs for the chat models)
!export/README.md
!export/chat/
!export/text/
!export/text-ascii/
.DS_Store
# Tier 1 source extractions are small and needed to rebuild corpus/tier1;
# the downloaded pages/PDFs/scans stay local (hashes in raw/MANIFEST.md).
!raw/tier1-*/
raw/tier1-*/download/
.claude/
nil[0-9]*/
data/audits/keys/
data/research/backtest/*.npz

# 8c packets with daughter text (some NC, research-only): local only; packets-loci/ is the committed copy
data/research/8c/packets/
data/research/8c/review/claims-*.jsonl
# 8c Stage B slabs with daughter text (research-only); slabs-loci/ is the committed copy
data/research/8c/stageB/slabs/
8c-stageB-key.json
data/research/8c/stageB/review/claims-*.jsonl
# 8c Stage C slabs with daughter text (CELT consent, research-only, NC): local only; slabs-loci/ is the committed copy
data/research/8c/stageC/slabs/
8c-stageC-key.json
data/research/8c/stageC/review/claims-*.jsonl
data/research/8c/stageC/review/claims-*.jsonl
data/research/8c/stageCS/slabs/
data/research/8c/stageCS-w*/slabs/
data/research/8c/stageCS/review/claims-*.jsonl
data/research/8c/stageCS/review-*/claims-*.jsonl
# Shared corpus search index and loader caches contain restricted corpus text; local only.
data/research/8c/search-index/
data/research/8c/stageCS/review-*/leads-*.jsonl
# Speech pipeline (docs/pronunciation.md "Speech"): compiled eSpeak-NG data, model-weight cache,
# the Kokoro Python 3.12 env, and rendered audio stay local; tts/samples/manifest.json is committed.
tts/espeak/build/
tts/cache/
tts/samples/*.wav
.venv-kokoro/

# D1 discovery caches (reproducible: scripts/discovery_d1.py extract/count)
data/research/discovery/d1/*.npz
# D2 discovery caches (reproducible: scripts/discovery_d2.py extract/count)
data/research/discovery/d2/*.npz
