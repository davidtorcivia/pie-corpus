# Downloaded material is untrusted and often large; provenance (URL, sha256,
# date) is recorded in raw/MANIFEST.md, which is tracked.
raw/*
!raw/.gitkeep
!raw/MANIFEST.md
.venv/
__pycache__/
*.pyc
.pytest_cache/
# export/ is regenerated by scripts/export.py
export/*
!export/.gitkeep
.DS_Store
# Tier 1 source extractions are small and needed to rebuild corpus/tier1;
# the downloaded pages/PDFs/scans stay local (hashes in raw/MANIFEST.md).
!raw/tier1-*/
raw/tier1-*/download/
.claude/
nil[0-9]*/
data/audits/keys/
