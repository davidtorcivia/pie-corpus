#!/bin/zsh
# The project's built environment directly: `uv run` takes the .venv lock, and ~40 parallel judge calls queued on it
# until they all hung (benchmark round 4, 2026-11-02). uv only if the environment is missing.
PY=/Users/david/AI/PIE/.venv/bin/python
if [ -x $PY ]; then exec $PY -I $(dirname $0)/tools.py "$@"; fi
export UV_CACHE_DIR=/tmp/pie-uv-cache
exec uv run --quiet --project /Users/david/AI/PIE python -I $(dirname $0)/tools.py "$@"
