{"plan_id": "t3b-001-0010", "genre": "dialogue", "theme": ["learning", "language"], "title": "The student", "plan": {"english": "I am a student. I read old words. Read, and I will teach you! Teacher, what is this word? It is an old word, and your fathers spoke it.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "closed:personal/1", "role": "SUBJ", "num": "SG"}, {"lex_id": "pie-neo-h1ewktoxr", "role": "PRED"}], "type": "nominal"}, {"speaker": "user", "slots": [{"lex_id": "pie-lex-wekwos", "role": "OBJ", "num": "PL"}, {"lex_id": "pie-lex-senos", "role": "MOD", "head": 0}, {"lex_id": "pie-neo-read", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-neo-read", "role": "V", "verb": {"tense": "PRS", "mood": "IMP", "voice": "ACT", "person": 2, "num": "SG"}}], "break": true}, {"speaker": "model", "slots": [{"lex_id": "closed:personal/2", "role": "OBJ", "num": "SG", "enclitic": true}, {"lex_id": "pie-neo-teach", "role": "V", "verb": {"tense": "PRS", "mood": "SBJV", "voice": "ACT", "person": 1, "num": "SG"}}], "conj": "kʷe"}, {"speaker": "user", "slots": [{"lex_id": "pie-neo-dokjtoxr", "role": "VOC"}, {"lex_id": "pie-lex-wekwos", "role": "SUBJ"}, {"lex_id": "closed:deictic_ki", "role": "MOD", "head": 1}, {"lex_id": "closed:interrogative_kwi", "role": "PRED", "gender": "n"}], "type": "nominal", "question": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "closed:anaphoric_i", "role": "SUBJ", "gender": "n"}, {"lex_id": "pie-lex-wekwos", "role": "PRED"}, {"lex_id": "pie-lex-senos", "role": "MOD", "head": 1}], "type": "nominal", "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-ph2texr", "role": "SUBJ", "num": "PL"}, {"lex_id": "closed:personal/2", "role": "POSS", "head": 0, "num": "SG", "enclitic": true}, {"lex_id": "closed:anaphoric_i", "role": "OBJ", "gender": "n"}, {"lex_id": "pie-lex-bheh2ti", "role": "V", "verb": {"tense": "PS