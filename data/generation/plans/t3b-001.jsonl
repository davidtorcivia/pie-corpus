{"plan_id": "t3b-001-0002", "genre": "dialogue", "theme": ["language", "the-machine"], "title": "The old tongue", "plan": {"english": "Do you speak the old tongue? I speak it. I learned it from many words. Who taught you? Teachers taught me.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-lex-dngjhweh2s", "role": "OBJ"}, {"lex_id": "pie-lex-senos", "role": "MOD", "head": 0}, {"lex_id": "pie-lex-bheh2ti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 2, "num": "SG"}}], "question": true}, {"speaker": "model", "slots": [{"lex_id": "closed:anaphoric_i", "role": "OBJ", "gender": "f"}, {"lex_id": "pie-lex-bheh2ti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "break": true}, {"speaker": "model", "slots": [{"lex_id": "closed:anaphoric_i", "role": "OBJ", "gender": "f"}, {"lex_id": "pie-lex-wekwos", "role": "ABL", "num": "PL"}, {"lex_id": "pie-lex-polh1us", "role": "MOD", "head": 1}, {"lex_id": "pie-lex-h1ewkt-2", "role": "V", "verb": {"tense": "AOR", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "break": true}, {"speaker": "user", "slots": [{"lex_id": "closed:interrogative_kwi", "role": "SUBJ", "gender": "m"}, {"lex_id": "closed:personal/2", "role": "OBJ", "num": "SG", "enclitic": true}, {"lex_id": "pie-neo-teach", "role": "V", "verb": {"tense": "PST", "mood": "IND", "voice": "ACT"}}], "question": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-neo-dokjtoxr", "role": "SUBJ", "num": "PL"}, {"lex_id": "closed:personal/1", "role": "OBJ", "num": "SG", "enclitic": true}, {"lex_id": "pie-neo-teach", "role": "V", "verb": {"tense": "PST", "mood": "IND", "voice": "ACT"}}], "break": true}]}}
{"plan_id": "t3b-001-0003", "genre": "dialogue", "theme": ["names", "greeting"], "title": "What is your name?", "plan": {"english": "What is your name? My name is Word-maker. And who are you? I am Of-Good-Fame. Joy is mine.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-lex-h1nomn", "role": "SUBJ"}, {"lex_id": "closed:personal/2", "role": "POSS", "head": 0, "enclitic": true, "num": "SG"}, {"lex_id": "closed:interrogative_kwi", "role": "PRED", "gender": "n"}], "type": "nominal", "question": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-h1nomn", "role": "SUBJ"}, {"lex_id": "closed:personal/1", "role": "POSS", "head": 0, "enclitic": true, "num": "SG"}, {"lex_id": "pie-neo-werdhokwrtexr", "role": "PRED"}], "type": "nominal", "break": true}, {"speaker": "model", "slots": [{"lex_id": "closed:personal/2", "role": "SUBJ", "num": "SG"}, {"lex_id": "closed:interrogative_kwi", "role": "PRED", "gender": "m"}], "type": "nominal", "question": true, "conj": "kʷe", "break": true}, {"speaker": "user", "slots": [{"lex_id": "closed:personal/1", "role": "SUBJ", "num": "SG", "gender": "m"}, {"lex_id": "compound", "role": "PRED", "compound": {"first": "closed:prefix/h1su", "second": "pie-lex-kjlewos", "type": "bahuvrihi"}}], "type": "nominal", "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-mowdos", "role": "SUBJ"}, {"lex_id": "closed:personal/1", "role": "IO", "num": "SG"}, {"lex_id": "pie-lex-h1esti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT"}}], "break": true}]}}
{"plan_id": "t3b-001-0004", "genre": "dialogue", "theme": ["writing", "the-machine"], "title": "Do you write?", "plan": {"english": "Do you write words? I write words, and I read them. Where do you write? I write on your screen, and you read.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-lex-wekwos", "role": "OBJ", "num": "PL"}, {"lex_id": "pie-neo-write", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 2, "num": "SG"}}], "question": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-wekwos", "role": "OBJ", "num": "PL"}, {"lex_id": "pie-neo-write", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "break": true}, {"speaker": "model", "slots": [{"lex_id": "closed:anaphoric_i", "role": "OBJ", "gender": "n", "num": "PL"}, {"lex_id": "pie-neo-read", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "conj": "kʷe"}, {"speaker": "user", "slots": [{"lex_id": "closed:interrogative_adv/where", "role": "ADV"}, {"lex_id": "pie-neo-write", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 2, "num": "SG"}}], "question": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-neo-deykjtrom", "role": "LOC"}, {"lex_id": "closed:personal/2", "role": "POSS", "head": 0, "num": "SG", "enclitic": true}, {"lex_id": "pie-neo-write", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-neo-read", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 2, "num": "SG"}}], "conj": "kʷe"}]}}
{"plan_id": "t3b-001-0005", "genre": "dialogue", "theme": ["banter", "the-machine"], "title": "Do you eat?", "plan": {"english": "Machine, do you eat? I do not eat. I eat words! You are a merry one!", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-neo-kwertrom", "role": "VOC"}, {"lex_id": "pie-lex-h1edti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 2, "num": "SG"}}], "question": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-h1edti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "neg": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-wekwos", "role": "OBJ", "num": "PL"}, {"lex_id": "pie-lex-h1edti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "break": true}, {"speaker": "user", "slots": [{"lex_id": "closed:personal/2", "role": "SUBJ", "num": "SG"}, {"lex_id": "pie-neo-smeytoxr", "role": "PRED"}], "type": "nominal", "break": true}]}}
