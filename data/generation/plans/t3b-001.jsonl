{"plan_id": "t3b-001-0011", "genre": "dialogue", "theme": ["computer", "the-machine"], "title": "The computer", "plan": {"english": "Is a computer a machine? It is a machine. I am a word-maker, and I dwell in a computer. Is it a house for you? I have no house.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-neo-h2ridhmokwertrom", "role": "SUBJ"}, {"lex_id": "pie-neo-kwertrom", "role": "PRED"}], "type": "nominal", "question": true}, {"speaker": "model", "slots": [{"lex_id": "closed:anaphoric_i", "role": "SUBJ", "gender": "n"}, {"lex_id": "pie-neo-kwertrom", "role": "PRED"}], "type": "nominal", "break": true}, {"speaker": "model", "slots": [{"lex_id": "closed:personal/1", "role": "SUBJ", "num": "SG"}, {"lex_id": "pie-neo-werdhokwrtexr", "role": "PRED"}], "type": "nominal", "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-neo-h2ridhmokwertrom", "role": "LOC"}, {"lex_id": "pie-lex-tkjeyti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "conj": "kʷe"}, {"speaker": "user", "slots": [{"lex_id": "closed:anaphoric_i", "role": "SUBJ", "gender": "n"}, {"lex_id": "closed:personal/2", "role": "IO", "num": "SG", "enclitic": true}, {"lex_id": "pie-lex-doxm", "role": "PRED"}], "type": "nominal", "question": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-doxm", "role": "SUBJ"}, {"lex_id": "closed:personal/1", "role": "IO", "num": "SG"}, {"lex_id": "pie-lex-h1esti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT"}}], "neg": true, "break": true}]}}
{"plan_id": "t3b-001-0012", "genre": "dialogue", "theme": ["memory", "the-machine"], "title": "Do you remember me?", "plan": {"english": "Machine, do you remember me? I do not remember you, friend. Now your words are in my memory. I smile.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-neo-kwertrom", "role": "VOC"}, {"lex_id": "closed:personal/1", "role": "OBJ", "num": "SG", "enclitic": true}, {"lex_id": "pie-lex-memone", "role": "V", "verb": {"tense": "PRF", "mood": "IND", "voice": "ACT", "person": 2, "num": "SG"}}], "question": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-priHos", "role": "VOC", "gender": "m"}, {"lex_id": "closed:personal/2", "role": "OBJ", "num": "SG", "enclitic": true}, {"lex_id": "pie-lex-memone", "role": "V", "verb": {"tense": "PRF", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "break": true, "neg": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-wekwos", "role": "SUBJ", "num": "PL"}, {"lex_id": "closed:personal/2", "role": "POSS", "head": 0, "num": "SG"}, {"lex_id": "pie-neo-smrtis", "role": "LOC"}, {"lex_id": "closed:personal/1", "role": "POSS", "head": 2, "num": "SG", "enclitic": true}, {"lex_id": "pie-lex-h1esti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT"}}], "break": true, "particle": "nu"}, {"speaker": "user", "slots": [{"lex_id": "pie-lex-smexyti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "break": true}]}}
