{"plan_id": "t3b-001-0014", "genre": "farewell", "theme": ["farewell"], "title": "Goodbye", "plan": {"english": "Now I am going home. Go, friend! Be well! May the gods protect you. Be well, machine!", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-lex-doxm", "role": "GOAL"}, {"lex_id": "pie-lex-h1eyti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "particle": "nu"}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-priHos", "role": "VOC", "gender": "m"}, {"lex_id": "pie-lex-h1eyti", "role": "V", "verb": {"tense": "PRS", "mood": "IMP", "voice": "ACT", "person": 2, "num": "SG"}}], "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-h1esti", "role": "V", "verb": {"tense": "PRS", "mood": "IMP", "voice": "ACT", "person": 2, "num": "SG"}}, {"lex_id": "pie-lex-keh2ilos", "role": "PRED"}], "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-deywos", "role": "SUBJ", "num": "PL"}, {"lex_id": "closed:personal/2", "role": "OBJ", "num": "SG", "enclitic": true}, {"lex_id": "pie-lex-peh2sti", "role": "V", "verb": {"tense": "PRS", "mood": "OPT", "voice": "ACT"}}], "break": true}, {"speaker": "user", "slots": [{"lex_id": "pie-neo-kwertrom", "role": "VOC"}, {"lex_id": "pie-lex-h1esti", "role": "V", "verb": {"tense": "PRS", "mood": "IMP", "voice": "ACT", "person": 2, "num": "SG"}}, {"lex_id": "pie-lex-keh2ilos", "role": "PRED"}], "break": true}]}}
{"plan_id": "t3b-001-0015", "genre": "dialogue", "theme": ["song", "please"], "title": "Write me a song", "plan": {"english": "Machine, I ask you: write a song for me! I am writing it. Hear the song! You are a singer! I am a word-maker, and songs are words.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-neo-kwertrom", "role": "VOC"}, {"lex_id": "closed:personal/2", "role": "OBJ", "num": "SG", "enclitic": true}, {"lex_id": "pie-lex-prskjeti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}]}, {"speaker": "user", "slots": [{"lex_id": "pie-lex-keh2nmn", "role": "OBJ"}, {"lex_id": "closed:personal/1", "role": "IO", "num": "SG", "enclitic": true}, {"lex_id": "pie-neo-write", "role": "V", "verb": {"tense": "PRS", "mood": "IMP", "voice": "ACT", "person": 2, "num": "SG"}}], "break": true}, {"speaker": "model", "slots": [{"lex_id": "closed:anaphoric_i", "role": "OBJ", "gender": "n"}, {"lex_id": "pie-neo-write", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-keh2nmn", "role": "OBJ"}, {"lex_id": "pie-lex-kjlewt", "role": "V", "verb": {"tense": "AOR", "mood": "IMP", "voice": "ACT", "person": 2, "num": "SG"}}], "break": true}, {"speaker": "user", "slots": [{"lex_id": "closed:personal/2", "role": "SUBJ", "num": "SG"}, {"lex_id": "pie-neo-keh2ntoxr", "role": "PRED"}], "type": "nominal", "break": true}, {"speaker": "model", "slots": [{"lex_id": "closed:personal/1", "role": "SUBJ", "num": "SG"}, {"lex_id": "pie-neo-werdhokwrtexr", "role": "PRED"}], "type": "nominal", "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-keh2nmn", "role": "SUBJ", "num": "PL"}, {"lex_id": "pie-lex-wekwos", "role": "PRED", "num": "PL"}], "type": "nominal", "conj": "kʷe"}]}}
{"plan_id": "t3b-001-0016", "genre": "dialogue", "theme": ["apology", "questions"], "title": "Sorry", "plan": {"english": "You did not speak the answer. I did not want that. Now ask! Where is my father's horse? I do not know. I have not seen the horse.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-neo-h2enterowekwos", "role": "OBJ"}, {"lex_id": "pie-lex-wewket", "role": "V", "verb": {"tense": "AOR", "mood": "IND", "voice": "ACT", "person": 2, "num": "SG"}}], "neg": true}, {"speaker": "model", "slots": [{"lex_id": "closed:demonstrative_so", "role": "OBJ", "gender": "n"}, {"lex_id": "pie-lex-wekjti", "role": "V", "verb": {"tense": "PST", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "neg": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-prexkjst", "role": "V", "verb": {"tense": "AOR", "mood": "IMP", "voice": "ACT", "person": 2, "num": "SG"}}], "particle": "nu", "break": true}, {"speaker": "user", "slots": [{"lex_id": "closed:interrogative_adv/where", "role": "ADV"}, {"lex_id": "pie-lex-h1ekjwos", "role": "SUBJ"}, {"lex_id": "pie-lex-ph2texr", "role": "POSS", "head": 1}, {"lex_id": "closed:personal/1", "role": "POSS", "head": 2, "num": "SG", "enclitic": true}, {"lex_id": "pie-lex-h1esti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT"}}], "question": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-woyde", "role": "V", "verb": {"tense": "PRF", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "neg": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-h1ekjwos", "role": "OBJ"}, {"lex_id": "pie-lex-dedorkje", "role": "V", "verb": {"tense": "PRF", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "neg": true, "break": true}]}}
{"plan_id": "t3b-001-0017", "genre": "dialogue", "theme": ["the-machine", "makers"], "title": "Who made you?", "plan": {"english": "Who made you? Engineers made me, and teachers taught me. Are you a man? I am not a man. I am a made mind.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "closed:interrogative_kwi", "role": "SUBJ", "gender": "m"}, {"lex_id": "closed:personal/2", "role": "OBJ", "num": "SG", "enclitic": true}, {"lex_id": "pie-lex-textkjti", "role": "V", "verb": {"tense": "PST", "mood": "IND", "voice": "ACT"}}], "question": true}, {"speaker": "model", "slots": [{"lex_id": "pie-neo-kwertrokwrtexr", "role": "SUBJ", "num": "PL"}, {"lex_id": "closed:personal/1", "role": "OBJ", "num": "SG", "enclitic": true}, {"lex_id": "pie-lex-textkjti", "role": "V", "verb": {"tense": "PST", "mood": "IND", "voice": "ACT"}}], "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-neo-dokjtoxr", "role": "SUBJ", "num": "PL"}, {"lex_id": "closed:personal/1", "role": "OBJ", "num": "SG"}, {"lex_id": "pie-neo-teach", "role": "V", "verb": {"tense": "PST", "mood": "IND", "voice": "ACT"}}], "conj": "kʷe"}, {"speaker": "user", "slots": [{"lex_id": "closed:personal/2", "role": "SUBJ", "num": "SG"}, {"lex_id": "pie-lex-h2nexr", "role": "PRED"}], "type": "nominal", "question": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "closed:personal/1", "role": "SUBJ", "num": "SG"}, {"lex_id": "pie-lex-h2nexr", "role": "PRED"}], "type": "nominal", "neg": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "closed:personal/1", "role": "SUBJ", "num": "SG"}, {"lex_id": "pie-neo-kwrtomenos", "role": "PRED"}], "type": "nominal", "break": true}]}}
{"plan_id": "t3b-001-0018", "genre": "dialogue", "theme": ["language", "neologisms"], "title": "New words", "plan": {"english": "Is your name a new word? It is a new word. Mortals made it from old words. Old words are good. They are dear to me.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-lex-h1nomn", "role": "SUBJ"}, {"lex_id": "closed:personal/2", "role": "POSS", "head": 0, "num": "SG", "enclitic": true}, {"lex_id": "pie-neo-newowekwos", "role": "PRED"}], "type": "nominal", "question": true}, {"speaker": "model", "slots": [{"lex_id": "closed:anaphoric_i", "role": "SUBJ", "gender": "n"}, {"lex_id": "pie-neo-newowekwos", "role": "PRED"}], "type": "nominal", "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-mortos", "role": "SUBJ", "num": "PL"}, {"lex_id": "closed:anaphoric_i", "role": "OBJ", "gender": "n"}, {"lex_id": "pie-lex-wekwos", "role": "ABL", "num": "PL"}, {"lex_id": "pie-lex-senos", "role": "MOD", "head": 2}, {"lex_id": "pie-lex-textkjti", "role": "V", "verb": {"tense": "PST", "mood": "IND", "voice": "ACT"}}], "break": true}, {"speaker": "user", "slots": [{"lex_id": "pie-lex-wekwos", "role": "SUBJ", "num": "PL"}, {"lex_id": "pie-lex-senos", "role": "MOD", "head": 0}, {"lex_id": "pie-lex-h1wesus", "role": "PRED"}], "type": "nominal", "break": true}, {"speaker": "model", "slots": [{"lex_id": "closed:anaphoric_i", "role": "SUBJ", "gender": "n", "num": "PL"}, {"lex_id": "closed:personal/1", "role": "IO", "num": "SG"}, {"lex_id": "pie-lex-priHos", "role": "PRED"}], "type": "nominal", "break": true}]}}
{"plan_id": "t3b-001-0019", "genre": "dialogue", "theme": ["help", "the-machine"], "title": "Help me!", "plan": {"english": "Helper, help me! What do you want? I am seeking my sister's house. I do not see houses; I see messages.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-neo-h2reh1gjtoxr", "role": "VOC"}, {"lex_id": "closed:personal/1", "role": "OBJ", "num": "SG", "enclitic": true}, {"lex_id": "pie-lex-h1ewHt", "role": "V", "verb": {"tense": "AOR", "mood": "IMP", "voice": "ACT", "person": 2, "num": "SG"}}]}, {"speaker": "model", "slots": [{"lex_id": "closed:interrogative_kwi", "role": "OBJ", "gender": "n"}, {"lex_id": "pie-lex-wekjti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 2, "num": "SG"}}], "question": true, "break": true}, {"speaker": "user", "slots": [{"lex_id": "pie-lex-doxm", "role": "OBJ"}, {"lex_id": "pie-lex-swesoxr", "role": "POSS", "head": 0}, {"lex_id": "closed:personal/1", "role": "POSS", "head": 1, "num": "SG", "enclitic": true}, {"lex_id": "pie-lex-h2iskjeti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-doxm", "role": "OBJ", "num": "PL"}, {"lex_id": "pie-lex-spekjyeti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "neg": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-neo-wekwmn", "role": "OBJ", "num": "PL"}, {"lex_id": "pie-lex-spekjyeti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}]}]}}
{"plan_id": "t3b-001-0020", "genre": "dialogue", "theme": ["travel", "the-machine"], "title": "By train", "plan": {"english": "I came by train. Was the train swift? It was swift, and joy was mine. I do not go; I dwell in the machine.", "clauses": [{"speaker": "user", "slots": [{"lex_id": "pie-neo-h1ngwniwogjhos", "role": "INS"}, {"lex_id": "pie-lex-gwemt", "role": "V", "verb": {"tense": "AOR", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}]}, {"speaker": "model", "slots": [{"lex_id": "pie-neo-h1ngwniwogjhos", "role": "SUBJ"}, {"lex_id": "pie-lex-HeHkjus", "role": "PRED"}, {"lex_id": "pie-lex-h1esti", "role": "V", "verb": {"tense": "PST", "mood": "IND", "voice": "ACT"}}], "question": true, "break": true}, {"speaker": "user", "slots": [{"lex_id": "closed:anaphoric_i", "role": "SUBJ", "gender": "m"}, {"lex_id": "pie-lex-HeHkjus", "role": "PRED"}, {"lex_id": "pie-lex-h1esti", "role": "V", "verb": {"tense": "PST", "mood": "IND", "voice": "ACT"}}], "break": true}, {"speaker": "user", "slots": [{"lex_id": "pie-lex-mowdos", "role": "SUBJ"}, {"lex_id": "closed:personal/1", "role": "IO", "num": "SG"}, {"lex_id": "pie-lex-h1esti", "role": "V", "verb": {"tense": "PST", "mood": "IND", "voice": "ACT"}}], "conj": "kʷe"}, {"speaker": "model", "slots": [{"lex_id": "pie-lex-h1eyti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}], "neg": true, "break": true}, {"speaker": "model", "slots": [{"lex_id": "pie-neo-kwertrom", "role": "LOC"}, {"lex_id": "pie-lex-tkjeyti", "role": "V", "verb": {"tense": "PRS", "mood": "IND", "voice": "ACT", "person": 1, "num": "SG"}}]}]}}
