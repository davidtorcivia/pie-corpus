 "exceptions": {
  "dia": {
   "day": "next word a weekday (sathairn, domnaig, luain, mairt, dardaoin, cétaín, aíne ... and spelling variants) or brátha; or cach/cech/gach before it unless chéile/céli/ceiliu or a lenited/nasalized word follows",
   "god": "next nime/nimhe, uilechumachtach, dúileach, na ndúl; mór/már only unit-initially or after the article; unit-initial Día before lim/limm/ocus/ecna/rí/día/tresin/dod-roíd/ar",
   "foreign": "die after hoc/eodem, in die + sancti/natali/domini, die sabba(ti), German die + Söhne/Glosse/Notiz/Angabe/Sätze",
   "untouched": "medial capitals (Día (name)); unaccented dia (already a function word by POS) except the day/god contexts"
  },
  "gona": "verbal noun kept after na, a, do, da, tri, trí, mo, boeghal/baoghal, bithin, cuingid, (d')iarraidh, artí or before nó/no/báis",
  "gonadh": "'was wounded' kept after ro, ra, do, no, ní, nír, níor, ar, coro, gur, gor, diar, nos, ros, dos",
  "asna": "rib kept after a, tria, trí, tre, dá, da, cech, gach, an, 'n, de'n, cen, gan; changes only before a dat. pl. (-aib/-ib/-ibh/-aibh/-iph/-aiph/-aip), a dual di/dí/da/dá, or an h-prefixed word",
  "gráin": "grain kept before eorna, cruithnechta, arba, coirce, seccail, sabhus, meles, glas, or after na / maille",
  "dál": "only before a capitalized (after mutation sign) people name; dál Temra/Temrach/Tailten (assembly) and the common noun kept",
  "eitir": "h-eitir/héitir and after ní/nach/ba/is/risba/nocha/níor -> étir@possible",
  "airc": "after ro/cur -> orcaid; Airc-siu do Emain -> téit@secondary; else airc@need",
  "risin": "hyphenated rí-sin 'that king' untouched",
  "all Irish rules": "a medial capital (loader name rule) is never changed"
 },
